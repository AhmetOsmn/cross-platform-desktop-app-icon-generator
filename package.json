{
    "name": "cpdaig",
    "version": "1.0.0",
    "description": "CLI tool to generate desktop application icons for Windows, Mac, and Linux from a single image",
    "main": "dist/index.js",
    "bin": {
        "cpdaig": "dist/index.js"
    },
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "ts-node src/index.ts"
